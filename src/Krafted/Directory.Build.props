<Project>
  <PropertyGroup>
    <Authors>Maicon Heck</Authors>
    <Copyright>Copyright (c) 2019 Maicon Heck</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <Version>5.1.0</Version>
    <PackageVersion>5.1.0</PackageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Krafted Guards</Product>
    <ProductName>Krafted Guards</ProductName>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <AssemblyTitle>$(MSBuildProjectName)</AssemblyTitle>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageProjectUrl>https://github.com/maiconheck/krafted</PackageProjectUrl>
    <RepositoryUrl>https://github.com/maiconheck/krafted.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>guard;guard-clause;guard-clauses;argument-validation;preconditions;defensive-programming;fail-fast;fluent-api</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../docfx_project/images/main/icon.png" Pack="true" PackagePath="\"/>
    <None Include="../../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
